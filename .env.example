# Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder.

# --- Database (native PostgreSQL on Windows) ---
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/relief_dev
# Optional: tests create and drop relief_test_<random> on this server.
# Defaults to DATABASE_URL with the database swapped.
TEST_DATABASE_URL=

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins (strict CORS).
CORS_ORIGINS=http://localhost:5173
# Production must serve over HTTPS. Set to true behind TLS (or a TLS-terminating proxy).
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=CHANGE_ME_BASE64_32_BYTES
# Pepper for phone-number HMACs. Never sent to clients (see DECISIONS C5).
PHONE_PEPPER=CHANGE_ME_BASE64_32_BYTES
# Wraps the per-operation data keys that encrypt PII inside the event log (DECISIONS C8).
DATA_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Operations ---
RETENTION_DAYS=90
SYNC_STALE_HOURS=24
BACKUP_DIR=./backups
# Daily in-process backup (pg_dump). Set to false to rely on Windows Task Scheduler instead.
BACKUP_DAILY=true
BACKUP_KEEP_DAYS=14

# --- First System Administrator (used by `pnpm seed` and `pnpm admin:create`) ---
SEED_ADMIN_MOBILE=01700000000
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
