{
  "name": "relief-coordination",
  "private": true,
  "description": "Offline-First Disaster Relief Distribution & Coordination System",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @relief/api start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @relief/web test:e2e",
    "db:generate": "pnpm --filter @relief/api db:generate",
    "db:migrate": "pnpm --filter @relief/api db:migrate",
    "seed": "pnpm --filter @relief/api seed",
    "seed:perf": "pnpm --filter @relief/api seed:perf",
    "admin:create": "pnpm --filter @relief/api admin:create",
    "backup": "pnpm --filter @relief/api backup",
    "backup:verify": "pnpm --filter @relief/api backup:verify",
    "simulate": "pnpm --filter @relief/api simulate",
    "evaluate": "pnpm --filter @relief/api evaluate",
    "audit:deps": "pnpm audit --audit-level=critical"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
