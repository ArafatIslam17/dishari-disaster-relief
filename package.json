{
  "name": "relief-coordination",
  "private": true,
  "description": "Offline-First Disaster Relief Distribution & Coordination System",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/workspace.mjs all build",
    "start": "node scripts/workspace.mjs api start",
    "typecheck": "node scripts/workspace.mjs all typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/workspace.mjs all test",
    "test:e2e": "node scripts/workspace.mjs web test:e2e",
    "db:generate": "node scripts/workspace.mjs api db:generate",
    "db:migrate": "node scripts/workspace.mjs api db:migrate",
    "seed": "node scripts/workspace.mjs api seed",
    "admin:create": "node scripts/workspace.mjs api admin:create",
    "backup": "node scripts/workspace.mjs api backup",
    "backup:verify": "node scripts/workspace.mjs api backup:verify",
    "simulate": "node scripts/workspace.mjs api simulate",
    "evaluate": "node scripts/workspace.mjs api evaluate",
    "audit:deps": "pnpm audit --audit-level=critical"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
