{
  "name": "@relief/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/wait-for-db.ts && tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup.ts --verify",
    "simulate": "tsx sim/simulate.ts",
    "evaluate": "tsx sim/evaluate.ts",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@relief/shared": "workspace:*",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "pdfkit": "0.21.0",
    "pg": "^8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.11",
    "fast-check": "^4.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "3.2.7"
  }
}
